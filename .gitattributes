# 统一换行：.ps1 必须是 CRLF（PowerShell 5.1 对混合换行更挑剔）
*.ps1   text eol=crlf

# 其余文本按 LF 存，跨平台友好
*.js    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf

# vendored 上游源码保持原始字节：MANIFEST.sha256 校验的是文件字节，
# 不能让 git 按文本规则转换换行（否则换台机器 checkout 后哈希全对不上）
vendor/wechatauto/** -text
