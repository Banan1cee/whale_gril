<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!-- 第 1 轮：启动器。CI 上传的是裸 exe（upload-artifact 的 archive: false），
       所以根元素直接是 pe-file，不用套一层 zip 包裹。

       下面这几个属性是 SignPath Foundation 要求的 file metadata restrictions：
       签名时会核对 exe 里真实的版本资源，对不上就不给签。
       product-name / company-name / product-version 要和
       launcher/WhaleLauncher.csproj 里的 <Product> / <Company> / <Version> 一致；
       version 由 CI 通过签名请求的 parameters 传进来（见 installer.yml）。 -->
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file path="WhaleLauncher.exe"
           product-name="鲸鲸"
           company-name="鲸鲸"
           product-version="${version}">
    <authenticode-sign />
  </pe-file>
</artifact-configuration>
