{
    "name": "whale-girl-bot",
    "version": "4.0",
    "private": false,
    "description": "鲸鲸 —— 模块化重构版（CommonJS，零 npm 依赖）",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node server.js",
        "doctor": "node server.js --doctor",
        "test": "node --test \"tests/*.test.js\"",
        "check-layers": "node scripts/check-layers.js",
        "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
        "release-check": "node scripts/release-check.js --release",
        "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
        "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
        "bump": "node scripts/bump-version.js",
        "ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ci-local.ps1"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "deepseek",
        "chatbot",
        "wechat",
        "wechat-bot",
        "bilibili",
        "llm"
    ],
    "license": "MIT",
    "author": "",
    "repository": {
        "type": "git",
        "url": ""
    }
}

