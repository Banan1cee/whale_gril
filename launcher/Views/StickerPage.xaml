<UserControl x:Class="WhaleLauncher.Views.StickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="表情包" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开文件夹" Style="{StaticResource Ghost}" Click="OnOpenFolder" />
                <Button Content="⟳ 刷新" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnReload" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="ChkEnabled" Content="启用表情包（实验性）" VerticalAlignment="Center" Click="OnToggleEnabled" />
                    <TextBlock x:Name="DirHint" Style="{StaticResource Small}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </WrapPanel>
                <TextBlock Text="只有在微信窗口处于前台、且账号校验通过时才会真的发出去；关掉开关会立刻取消所有排队任务。"
                           Style="{StaticResource Small}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel x:Name="Tabs" Orientation="Horizontal" VerticalAlignment="Center" />
            <TextBox x:Name="TxtNewCat" Width="110" Height="24" Margin="14,0,0,0" ToolTip="新分类的名字（文件夹会同名建出来）" />
            <Button Content="＋ 新分类" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="OnAddCategory" />
            <Button x:Name="BtnDelCat" Content="删除分类" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                    Visibility="Collapsed" Click="OnDeleteCategory"
                    ToolTip="只从列表里去掉，文件夹和图片都保留" />
            <Button Content="上传图片…" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnUpload" />
            <TextBlock x:Name="QueueInfo" Style="{StaticResource Small}" Margin="14,0,0,0" VerticalAlignment="Center" />
        </WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="可选：真实消息测试" FontWeight="SemiBold" />
                <TextBlock Text="测试会向微信发出一条真实消息，并可能短暂切换窗口、发完还原。先确认接收会话是空的；排队不代表送达，微信窗口不在前台时桥接会推迟。"
                           Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="接收会话" Style="{StaticResource Small}" VerticalAlignment="Center" />
                    <TextBox x:Name="TxtTestChat" Width="200" Height="24" Margin="10,0,0,0"
                             ToolTip="填微信里的备注名/昵称；默认用设置里的「测试发送到哪个会话」" />
                    <Button Content="排队测试发送" Style="{StaticResource Primary}" Margin="10,0,0,0" Click="OnTestSend" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10">
                    <WrapPanel x:Name="GridHost" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" />
            <StackPanel x:Name="JobsHost" Margin="0,8,0,0" />
        </DockPanel>
    </Grid>
</UserControl>
