<UserControl x:Class="WhaleLauncher.Views.DiagPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="诊断" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⟳ 重新自检" Style="{StaticResource Ghost}" Click="OnRecheck" />
                <Button Content="UIA 自检" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnUiaCheck"
                        ToolTip="检查微信的 UIA 控件树能不能用（发送走不走快通道）" />
                <Button Content="数据目录" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnOpenDataDir"
                        ToolTip="打开 data 目录（日志、配置、记忆都在这里）" />
                <Button x:Name="BtnExport" Content="导出日志" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnExport"
                        ToolTip="一键打包：当次启动 + 最近两次启动的日志、崩溃栈、判定链、脱敏配置、doctor。存到 data/ 里并打开所在文件夹" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 自检 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="自检" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <StackPanel x:Name="CheckHost" />
                </DockPanel>
            </Border>

            <!-- 内核日志 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="内核日志" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="（桥接的日志在「微信 · 桥接」页）" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkErrors" Content="仅异常" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnFilterChanged" />
                                <TextBox x:Name="TxtSearch" Width="130" Margin="12,0,0,0" TextChanged="OnSearchChanged" ToolTip="搜关键字" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="CmbTail" Width="96" Height="24" SelectionChanged="OnTailChanged">
                                    <ComboBoxItem Content="尾部 500" />
                                    <ComboBoxItem Content="尾部 2000" />
                                    <ComboBoxItem Content="全部" />
                                </ComboBox>
                                <Button Content="清屏" Style="{StaticResource TopBtn}" Click="OnClear" />
                                <Button Content="复制" Style="{StaticResource TopBtn}" Click="OnCopy" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="Logs" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="10,1">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Dim}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelChar}" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Src}" Foreground="{DynamicResource Accent}" Opacity="0.7" />
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部：路径 / 运行时 / 通道 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="路径与占用" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <StackPanel x:Name="PathsHost" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="运行与通道" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBlock x:Name="RuntimeInfo" Style="{StaticResource Value}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 数据维护：备份 / 恢复 / 重置（都是本机操作，不用再开 bat） -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="数据维护" Style="{StaticResource Label}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="备份记忆" Style="{StaticResource Ghost}" Click="OnBackupMemory"
                            ToolTip="导出成一个 JSON（默认去掉 API Key），可换机恢复" />
                    <Button Content="恢复记忆" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnRestoreMemory"
                            ToolTip="选一个自动快照或外部文件恢复；恢复前会先停内核并自动备份当前记忆" />
                    <Button x:Name="BtnFactoryReset" Content="重置全部" Style="{StaticResource Ghost}"
                            Margin="8,0,0,0" Click="OnFactoryReset" Foreground="{DynamicResource Bad}"
                            ToolTip="恢复出厂：清空记忆、Key、人设和设置；会先自动备份到 backup\reset-时间戳" />
                </StackPanel>
                <TextBlock x:Name="MaintenanceHint" Style="{StaticResource Small}" VerticalAlignment="Center"
                           Margin="0,0,14,0" TextWrapping="Wrap" Foreground="{DynamicResource Dim}"
                           Text="备份出来的文件默认不含 Key；恢复前会自动留一份当前记忆。" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>