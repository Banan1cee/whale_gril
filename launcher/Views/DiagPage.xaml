<UserControl x:Class="WhaleLauncher.Views.DiagPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 「导出日志」悬浮窗里的可点选项：整行可点，悬停用主题的 Hover -->
        <Style x:Key="ExportOption" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="9" Padding="9,7">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="诊断" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⟳ 重新自检" Style="{StaticResource Ghost}" Click="OnRecheck" />
                <Button Content="数据目录" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnOpenDataDir"
                        ToolTip="打开 data 目录（日志、配置、记忆都在这里）" />
                <Button x:Name="BtnExport" Content="导出日志" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnExport"
                        ToolTip="导出最近 10 分钟 / 当次启动的 debug 日志包" />

                <!-- 导出浮窗：点按钮在它下方展开的小卡片，选一个时间范围就开始导出 -->
                <Popup x:Name="ExportPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnExport}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       HorizontalOffset="-190" VerticalOffset="6">
                    <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="6" Width="276">
                        <StackPanel>
                            <TextBlock Text="导出 debug 日志包" Style="{StaticResource Label}" Margin="9,5,9,4" />
                            <Button Style="{StaticResource ExportOption}" Click="OnExportRecent10"
                                    ToolTip="只导出最近 10 分钟内的日志">
                                <StackPanel>
                                    <TextBlock Text="最近 10 分钟" Foreground="{DynamicResource Text}" FontSize="12.5" />
                                    <TextBlock Text="只导出最近 10 分钟内的日志行" Style="{StaticResource Small}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ExportOption}" Margin="0,2,0,0" Click="OnExportThisRun"
                                    ToolTip="本次启动以来的日志；内核没在跑时导出最近一次启动的">
                                <StackPanel>
                                    <TextBlock Text="当次启动" Foreground="{DynamicResource Text}" FontSize="12.5" />
                                    <TextBlock Text="本次启动以来的日志；没在运行就导出最近一次启动的" Style="{StaticResource Small}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 自检 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="自检" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <StackPanel x:Name="CheckHost" />
                </DockPanel>
            </Border>

            <!-- 内核日志 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="内核日志" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="（桥接的日志在「微信 · 桥接」页）" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                <CheckBox x:Name="ChkErrors" Content="仅异常" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnFilterChanged" />
                                <TextBox x:Name="TxtSearch" Width="130" Margin="12,0,0,0" TextChanged="OnSearchChanged" ToolTip="搜关键字" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="CmbTail" Width="96" Height="24" SelectionChanged="OnTailChanged">
                                    <ComboBoxItem Content="尾部 500" />
                                    <ComboBoxItem Content="尾部 2000" />
                                    <ComboBoxItem Content="全部" />
                                </ComboBox>
                                <Button Content="清屏" Style="{StaticResource TopBtn}" Click="OnClear" />
                                <Button Content="复制" Style="{StaticResource TopBtn}" Click="OnCopy" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="Logs" Background="Transparent" BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="10,1">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Dim}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LevelChar}" Foreground="{DynamicResource Warn}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Src}" Foreground="{DynamicResource Accent}" Opacity="0.7" />
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部：路径 / 运行时 / 通道 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="路径与占用" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <StackPanel x:Name="PathsHost" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="运行与通道" Style="{StaticResource Label}" Margin="0,0,0,6" />
                    <TextBlock x:Name="RuntimeInfo" Style="{StaticResource Value}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
