<UserControl x:Class="WhaleLauncher.Views.ReminderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="主动与提醒" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="⟳ 刷新"
                    Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="HintText"
                   Text="到点自动发；发送失败 5 分钟后重试一次；过期的不再补发"
                   Style="{StaticResource Small}" Margin="0,6,0,10" TextWrapping="Wrap" />

        <!-- 整页一个滚动条：两张规则卡 + 提醒列表都在里面。
             以前这里没有 ScrollViewer，内容一多就顶出窗口，滚轮也没反应（用户反馈）。 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
            <StackPanel Margin="0,0,10,0">

                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="日记" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Text="沿用当前人设和聊天模型，根据当天聊天写 Markdown 日记，保存到 data/diary/年份/月-日.md（如 2026/11-06.md）。手动和自动每天合计一篇，当天已有就跳过。内核运行时按电脑本地时间生成；当天错过时间会补写，过去日期不补写。当天无聊天则跳过。"
                                   Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <CheckBox x:Name="ChkDiaryEnabled" Content="每天自动写日记（默认关闭）" Margin="0,0,0,8" />
                        <WrapPanel>
                            <TextBlock Text="生成时间（HH:mm）" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="TxtDiaryTime" Text="23:00" Width="80" Margin="0,0,10,0" />
                            <Button x:Name="BtnSaveDiary" Content="保存日记设置" Style="{StaticResource Primary}" Click="OnSaveDiary" Margin="0,0,10,0" />
                            <Button x:Name="BtnWriteDiary" Content="立即写一篇" Style="{StaticResource Ghost}" Click="OnWriteDiary" Margin="0,0,10,0" />
                            <Button Content="打开日记文件夹" Style="{StaticResource Ghost}" Click="OnOpenDiary" />
                        </WrapPanel>
                        <TextBlock x:Name="DiarySettingsStatus" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="DiaryStatus" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 提醒规则：字段语义和「主动搭话」一致，但这是提醒自己的配置 -->
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="提醒规则" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Text="和主动搭话同一套规则语义，但配置独立：当日次数用完、或刚聊过（按下面设置）就不发，也不会推迟补发。提醒不限制时间段 —— 你定几点就几点发。"
                                   Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkEnabled" Content="开启提醒" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="每天最多提醒几次（0 = 不限）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtMaxPerDay" Width="120" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="刚聊过先跳过（分钟，0 = 不跳过）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtQuiet" Width="120" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>

                        <DockPanel LastChildFill="False">
                            <Button x:Name="BtnSaveRules" Content="保存规则" Style="{StaticResource Primary}"
                                    Click="OnSaveRules" DockPanel.Dock="Left" />
                            <TextBlock x:Name="RulesStatus" Style="{StaticResource Small}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" DockPanel.Dock="Left" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 主动搭话：和提醒同一页，省得在两处来回对规则 -->
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="主动搭话" Style="{StaticResource H2}" Margin="0,0,0,6" />
                        <TextBlock Text="没聊的时候她自己来一句。判定只在服务端做一次：时间窗、频率、每日上限、白名单、下面三个开关都算在内。"
                                   Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkCareEnabled" Content="开启主动搭话" Margin="0,0,0,8" />

                        <WrapPanel>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="平均间隔（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCareEvery" Width="96" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="间隔浮动（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCareJitter" Width="96" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="每天最多几次（0 = 不限）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCareMax" Width="96" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="刚聊过先跳过（分钟）" Style="{StaticResource Small}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtCareQuiet" Width="96" HorizontalAlignment="Left" />
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="允许的时间段（每行一个，如 09:00-12:00；跨零点也认；留空 = 全天）"
                                   Style="{StaticResource Small}" Margin="0,10,0,4" />
                        <TextBox x:Name="TxtCareWindows" MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" />

                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="ChkCareOnlyMaster" Content="只找主人" Margin="0,0,18,0" />
                            <CheckBox x:Name="ChkCareGroups" Content="允许在群里主动" Margin="0,0,18,0" />
                            <CheckBox x:Name="ChkCareOthers" Content="允许主动找别人" />
                        </WrapPanel>

                        <TextBlock Text="白名单（留空 = 主人 + 文件传输助手；选完立即保存）"
                                   Style="{StaticResource Small}" Margin="0,10,0,4" />
                        <ContentControl x:Name="WhitelistHost" />

                        <TextBlock Text="黑名单（静音的群 / 人；勾「全部静音」= 所有会话都不接；选完立即保存）"
                                   Style="{StaticResource Small}" Margin="0,8,0,4" />
                        <ContentControl x:Name="MutedHost" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="BtnSaveCare" Content="保存主动搭话" Style="{StaticResource Primary}" Click="OnSaveCare" />
                            <TextBlock x:Name="CareStatus" Style="{StaticResource Small}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 提醒列表：跟着整页滚，不再自己套一层滚动（嵌套滚动会让滚轮打架） -->
                <Border Style="{StaticResource Card}" Padding="10" MinHeight="180">
                    <Grid>
                        <ItemsControl x:Name="ReminderList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Text}"
                                                           FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                           FontSize="11" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Wxid}" Style="{StaticResource Small}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Muted}"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Bad}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding ErrorVisibility}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="删除" Style="{StaticResource Ghost}"
                                                    Tag="{Binding Id}" Click="OnCancelReminder"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText" Text="还没有提醒" Style="{StaticResource Small}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="24" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource Small}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
