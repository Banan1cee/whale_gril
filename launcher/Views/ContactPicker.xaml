<Window x:Class="WhaleLauncher.Views.ContactPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择联系人" Height="600" Width="560" MinHeight="420" MinWidth="460"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontSize="12.5" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Text="选择联系人" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" />
            <TextBlock x:Name="SubText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged" ToolTip="按名字 / 备注 / wxid 搜" />
            <ComboBox x:Name="TypeBox" Grid.Column="1" Width="96" Margin="8,0,0,0" SelectedIndex="0"
                      SelectionChanged="OnTypeChanged">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="私聊" />
                <ComboBoxItem Content="群聊" />
            </ComboBox>
            <Button x:Name="BtnReload" Grid.Column="2" Content="⟳ 刷新列表" Style="{StaticResource Ghost}"
                    Margin="8,0,0,0" Click="OnReload" />
        </Grid>

        <StackPanel x:Name="AllMuteHost" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <CheckBox x:Name="AllMuteCheck" Content="全部静音（*）" />
            <TextBlock x:Name="AllMuteHint" Style="{StaticResource Small}" Foreground="{DynamicResource Warn}"
                       TextWrapping="Wrap" Margin="21,4,0,0" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,10,0,0">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="2,0">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="OnItemToggled"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource Text}"
                                                       FontSize="12" />
                                            <Border Background="{DynamicResource Surface3}" CornerRadius="3" Padding="5,1"
                                                    Margin="7,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding GroupBadgeVisibility}">
                                                <TextBlock Text="群" Foreground="{DynamicResource Accent}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="StateText" Style="{StaticResource Small}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24" Visibility="Collapsed" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="FootText" DockPanel.Dock="Left" Style="{StaticResource Small}"
                       VerticalAlignment="Center" Text="已选 0 个" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Ghost}" IsCancel="True" />
                <Button Content="确定" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="OnOk" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
