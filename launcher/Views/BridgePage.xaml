<UserControl x:Class="WhaleLauncher.Views.BridgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" MaxHeight="360" />
            <RowDefinition Height="6" />
            <RowDefinition Height="1.6*" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="微信 · 桥接" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⟳ 刷新账号" Style="{StaticResource Ghost}" Click="OnRefreshAccounts" />
                <Button Content="⟳ 重启桥接" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnRestartBridge" />
            </StackPanel>
        </DockPanel>

        <!-- 上半：微信设置 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="账号" Style="{StaticResource Label}" Margin="0,0,0,6" />
                <ItemsControl x:Name="Accounts">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,8" MinWidth="190">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Small}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="AccountsEmpty" Text="桥接没连上，读不到账号。先确认微信已登录、桥接在跑。"
                           Style="{StaticResource Small}" Margin="0,2,0,0" />

                <TextBlock Text="开关" Style="{StaticResource Label}" Margin="0,14,0,8" />
                <WrapPanel>
                    <CheckBox x:Name="ChkGuard" Content="双开守卫" Foreground="{DynamicResource Text}" FontSize="12"
                              VerticalAlignment="Center" Click="OnToggleGuard" Margin="0,0,22,0" />
                    <CheckBox x:Name="ChkQuote" Content="引用回复" Foreground="{DynamicResource Text}" FontSize="12"
                              VerticalAlignment="Center" Click="OnToggleQuote" Margin="0,0,22,0" />
                    <TextBlock Text="发送方式" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbSend" Width="210" FontSize="12" VerticalAlignment="Center"
                              SelectionChanged="OnSendModeChanged" />
                </WrapPanel>
                <TextBlock x:Name="SwitchHint" Style="{StaticResource Small}" Margin="0,8,0,0"
                           Text="引用回复会让每条多等好几秒；发送方式改了会立刻写回配置。" />

                <TextBlock Text="权限与窗口" Style="{StaticResource Label}" Margin="0,14,0,8" />
                <TextBlock x:Name="PermLine" Text="—" Style="{StaticResource Value}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      ShowsPreview="False" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />

        <!-- 下半：桥接控制台 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="桥接控制台" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <CheckBox x:Name="ChkFollow" Content="跟随" Foreground="{DynamicResource Muted}" FontSize="11"
                                      IsChecked="True" VerticalAlignment="Center" Click="OnConsoleOption" />
                            <CheckBox x:Name="ChkErrors" Content="仅错误" Foreground="{DynamicResource Muted}" FontSize="11"
                                      VerticalAlignment="Center" Margin="12,0,0,0" Click="OnConsoleOption" />
                            <TextBox x:Name="TxtSearch" Width="140" Height="22" Margin="12,0,0,0" FontSize="11"
                                     Background="{DynamicResource FieldBg}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource FieldBorder}"
                                     VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                                     ToolTip="搜关键字，回车不生效，边打边过滤" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnPause" Content="暂停" Style="{StaticResource TopBtn}" Click="OnPause" />
                            <Button Content="清屏" Style="{StaticResource TopBtn}" Click="OnClear" />
                            <Button Content="复制" Style="{StaticResource TopBtn}" Click="OnCopy" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ListBox x:Name="Console" Background="Transparent" BorderThickness="0"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="10,1">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Dim}" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelChar}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LevelChar}" Value="w">
                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LevelChar}" Value="e">
                                                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Src}" Foreground="{DynamicResource Accent}" Opacity="0.7" />
                                <TextBlock Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 控制台状态条 -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="ConsoleStat" DockPanel.Dock="Left" Style="{StaticResource Small}" VerticalAlignment="Center" />
            <Button x:Name="BtnOpenBridgeLog" DockPanel.Dock="Right" Content="打开日志文件" Style="{StaticResource TopBtn}"
                    HorizontalAlignment="Right" Click="OnOpenBridgeLog" />
        </DockPanel>
    </Grid>
</UserControl>
