<UserControl x:Class="WhaleLauncher.Views.PersonaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="人设" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="CurrentPreset" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="⟳ 重新读取" Style="{StaticResource Ghost}" Click="OnReload" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                    <!-- 身份 -->
                    <Border x:Name="SecIdentity" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="身份" Style="{StaticResource H2}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="名字" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtName" Grid.Column="1" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="1" Text="她怎么叫你" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtOwner" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="2" Text="年龄" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtAge" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="3" Text="职业" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtJob" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="4" Text="外观" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtLook" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" MinHeight="52"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="5" Text="性格" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtPerson" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="6" Text="背景" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtBack" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" MinHeight="60"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="7" Text="自定义提示词" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtPrompt" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus" />

                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 主人身份 -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="主人身份" Style="{StaticResource H2}" />
                            <TextBlock Text="谁算主人：填了就算。昵称谁都能改，wxid 最可靠；两个都填时任一命中即可。"
                                       Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="别名 / 外号" Style="{StaticResource Label}" VerticalAlignment="Top" />
                                <TextBox x:Name="TxtAliases" Grid.Column="1" MinHeight="56"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus"
                                         ToolTip="一行一个；群里喊这些也算叫她" />
                                <TextBlock Grid.Row="1" Text="主人名单（昵称）" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtMasterNames" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MinHeight="44"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus"
                                         ToolTip="一行一个。微信里改昵称就能冒充，建议同时填下面的 wxid" />
                                <TextBlock Grid.Row="2" Text="主人名单（wxid）" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtMasterWxids" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MinHeight="44"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" LostFocus="OnFieldLostFocus"
                                         ToolTip="一行一个 wxid_xxx，最可靠" />
                                <TextBlock Grid.Row="3" Text="主人骂她时允许还嘴" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <CheckBox x:Name="ChkRoast" Grid.Row="3" Grid.Column="1" Content="允许还嘴（关掉 = 只委屈不顶嘴）"
                                          Margin="0,8,0,0" VerticalAlignment="Center" Click="OnToggleField" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 说话方式 -->
                    <Border x:Name="SecTalk" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="说话方式" Style="{StaticResource H2}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="私聊字数上限" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtPrivate" Grid.Column="1" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Column="2" x:Name="HintPrivate" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,0,0,0" />

                                <TextBlock Grid.Row="1" Text="群聊字数上限" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtGroup" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="HintGroup" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,8,0,0" />

                                <TextBlock Grid.Row="2" Text="历史轮数" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtTurns" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="带进提示词的对话轮数，越大越贵" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,8,0,0" />

                                <TextBlock Grid.Row="3" Text="群聊历史轮数" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtGroupTurns" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />

                                <TextBlock Grid.Row="4" Text="颜文字用量" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Slider x:Name="SldEmoji" Width="230" Minimum="0" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnEmojiChanged" />
                                    <TextBlock x:Name="HintEmoji" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="5" Text="最多分几条消息" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtBubbles" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" LostFocus="OnFieldLostFocus" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="长回复才拆，短句仍然一条" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="10,8,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 群聊相关配置统一在「设置 → 群聊」，这里不再重复一份 -->

                    <!-- 情绪与主动 -->
                    <Border x:Name="SecMood" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="情绪与主动性" Style="{StaticResource H2}" />
                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox x:Name="ChkEmotions" Content="有情绪（会随时间和话题变化）" VerticalAlignment="Center" Click="OnToggleField" />
                                <CheckBox x:Name="ChkProactive" Content="会主动找话题" Margin="22,0,0,0" VerticalAlignment="Center" Click="OnToggleField" />
                            </WrapPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <CheckBox x:Name="ChkOpinions" Content="有自己的看法（会顶嘴）" VerticalAlignment="Center" Click="OnToggleField" />
                                <CheckBox x:Name="ChkLinks" Content="会看链接内容" Margin="22,0,0,0" VerticalAlignment="Center" Click="OnToggleField" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 预设 -->
                    <Border x:Name="SecPreset" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="人设预设" Style="{StaticResource H2}" />
                            <TextBlock Text="presets 里的人设版本。导入会覆盖上面「身份」和「说话方式」里的对应字段。"
                                       Style="{StaticResource Small}" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <ComboBox x:Name="CmbPreset" Width="300" Height="28" />
                                <Button Content="导入这版" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="OnImportPreset" />
                            </WrapPanel>
                            <TextBlock x:Name="PresetResult" Style="{StaticResource Small}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 实验开关 -->
                    <Border x:Name="SecFlags" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="实验开关" Style="{StaticResource H2}" />
                            <TextBlock Text="关掉 = 回到旧行为，不会崩。每项都写着默认值和关掉会怎样。"
                                       Style="{StaticResource Small}" Margin="0,6,0,0" />
                            <StackPanel x:Name="FlagsHost" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="SaveState" DockPanel.Dock="Left" Style="{StaticResource Small}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="全部保存" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="OnSaveAll" />
        </DockPanel>
    </Grid>
</UserControl>
