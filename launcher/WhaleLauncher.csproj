<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>WhaleLauncher</AssemblyName>
    <RootNamespace>WhaleLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 窗口/任务栏/exe 文件图标：鲸鲸（右下角那只小人，气泡去掉了） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>4.0.6</Version>
    <!-- 产品版本只写版本号，别让 SDK 把 git sha 拼成 4.0.0+ae20f30：
         SignPath 的 artifact configuration 用 product-version 做元数据约束，
         值必须每次构建都一致；用户看到的「产品版本」也不该是个提交号。 -->
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ProductVersion>$(Version)</ProductVersion>
    <FileVersion>4.0.6.0</FileVersion>
    <Product>鲸鲸</Product>
    <AssemblyTitle>鲸鲸 · 启动器</AssemblyTitle>
    <Company>鲸鲸</Company>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 不要调试符号：exe 的 debug 目录会写进编译机上的 PDB 绝对路径，
         发布出去等于把本机用户目录带进仓库（隐私扫描和 CI 都会红）。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- 图标同时当资源：MainWindow 的 Icon="Assets/app.ico" 走 pack URI 读这个 -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    发布（单文件、框架依赖，产物只有一个 exe）：
      dotnet publish launcher/WhaleLauncher.csproj -c Release -o launcher/publish -p:PublishSingleFile=true -p:SelfContained=false
    然后把 launcher/publish/WhaleLauncher.exe 复制到仓库根目录一份。
    不要用默认发布：默认会把 WhaleLauncher.dll / .deps.json 拆出来，单发 exe 起不来。
  -->
</Project>
