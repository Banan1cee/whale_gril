<UserControl x:Class="WhaleLauncher.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="设置" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <TextBlock x:Name="KernelHint" DockPanel.Dock="Right" Style="{StaticResource Small}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SectionsHost" Margin="0,0,10,0" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource Small}" VerticalAlignment="Center" />
            <TextBlock x:Name="AboutText" DockPanel.Dock="Right" Style="{StaticResource Small}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</UserControl>
