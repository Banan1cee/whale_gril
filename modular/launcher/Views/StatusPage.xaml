<UserControl x:Class="WhaleLauncher.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="状态" Style="{StaticResource H1}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="⟳ 刷新" Style="{StaticResource Ghost}"
                    HorizontalAlignment="Right" Click="OnRefresh" />
        </DockPanel>

        <!-- 三卡 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotNode" Width="9" Height="9" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="内核" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NodeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="NodeMain" Text="未启动" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="NodeSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotBridge" Width="9" Height="9" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="桥接" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BridgeAge" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="BridgeMain" Text="未启动" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="BridgeSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotWechat" Width="9" Height="9" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="微信" Style="{StaticResource Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WechatMain" Text="未知" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="0,9,0,0" />
                    <TextBlock x:Name="WechatSub" Text="—" Style="{StaticResource Small}" Margin="0,5,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 用量 + 主动搭话 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="UsageLine" Text="本次运行  —" Style="{StaticResource Value}" FontSize="13" />
                <TextBlock x:Name="CareLine" Text="主动搭话  —" Style="{StaticResource Small}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 最近动态 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="最近动态" Style="{StaticResource H2}" />
                    <TextBlock x:Name="RecentHint" DockPanel.Dock="Right" Style="{StaticResource Small}" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Recent" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="0,3">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{StaticResource Muted}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{StaticResource Text}"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="RecentEmpty" Text="还没有消息。先在微信里跟她说一句。"
                               Style="{StaticResource Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 排障动作 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="重启桥接" Style="{StaticResource Ghost}" Click="OnRestartBridge" />
            <Button Content="导出诊断包" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnExportDiag" />
            <Button Content="打开数据目录" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnOpenData" />
        </StackPanel>
    </Grid>
</UserControl>
