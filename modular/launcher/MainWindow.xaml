<Window x:Class="WhaleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鲸" Height="720" Width="1180" MinHeight="600" MinWidth="960"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶栏：三个点 + 起停 -->
        <Border Grid.Row="0" Background="{StaticResource BgTop}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0" VerticalAlignment="Center" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🐋" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="鲸鲸" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border Background="#FF2E3238" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v4.0.0-alpha" Foreground="{StaticResource Muted}" FontSize="11" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="26,0,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="DotNode" Width="8" Height="8" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="内核" Style="{StaticResource Label}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <Ellipse x:Name="DotBridge" Width="8" Height="8" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="桥接" Style="{StaticResource Label}" Margin="6,0,18,0" VerticalAlignment="Center" />
                        <Ellipse x:Name="DotWechat" Width="8" Height="8" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="WechatLabel" Text="微信" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnRestart" Content="⟳ 重启" Style="{StaticResource TopBtn}" Click="OnRestart" ToolTip="先停内核与桥接，再按固定顺序重启" />
                    <Button x:Name="BtnToggle" Content="⏻ 停止" Style="{StaticResource TopBtn}" Click="OnToggle" Margin="2,0,0,0" />
                    <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="6,0" />
                    <Button x:Name="BtnSettings" Content="⚙" Style="{StaticResource TopBtn}" Click="OnSettings" FontSize="14" ToolTip="设置" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 左栏 + 主区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgNav}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <ListBox x:Name="Nav" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" Margin="0,10,0,0"
                             SelectionChanged="OnNavChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <ContentControl x:Name="Host" Grid.Column="1" />
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgTop}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLine" DockPanel.Dock="Left" Text="启动器就绪" Style="{StaticResource Small}" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnDataDir" Content="数据目录" Style="{StaticResource TopBtn}" FontSize="11" Padding="6,2"
                            Click="OnOpenData" Cursor="Hand" />
                    <TextBlock x:Name="FootVersion" Text="v4.0.0-alpha" Style="{StaticResource Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
