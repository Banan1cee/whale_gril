<Window x:Class="WhaleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="鲸鲸" Height="560" Width="760" MinHeight="520" MinWidth="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="🐋" FontSize="26" VerticalAlignment="Center" />
            <TextBlock Text="鲸鲸" Style="{StaticResource H1}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Border Background="#FF2E3238" CornerRadius="10" Padding="10,3" Margin="12,4,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Text="v4.0.0-alpha" Foreground="{StaticResource Muted}" FontSize="12" />
            </Border>
        </StackPanel>

        <!-- 三张状态卡 -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,0">
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotNode" Width="10" Height="10" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="内核" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TextNode" Text="未启动" Style="{StaticResource Value}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotBridge" Width="10" Height="10" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="桥接" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TextBridge" Text="未启动" Style="{StaticResource Value}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DotWechat" Width="10" Height="10" Fill="{StaticResource Idle}" VerticalAlignment="Center" />
                        <TextBlock Text="微信" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TextWechat" Text="未知" Style="{StaticResource Value}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 通道与最近一条 -->
        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="通道" Style="{StaticResource Label}" />
                <TextBlock x:Name="TextChannel" Text="—" Style="{StaticResource Value}" Margin="0,4,0,0" />
                <TextBlock Text="最近" Style="{StaticResource Label}" Margin="0,12,0,0" />
                <TextBlock x:Name="TextLast" Text="还没有消息" Style="{StaticResource Value}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="日志" Style="{StaticResource Label}" Margin="2,0,0,6" />
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource Muted}"
                             BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                             FontSize="12" VerticalScrollBarVisibility="Hidden" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button x:Name="BtnStart" Content="启动" Style="{StaticResource Primary}" Click="OnStart" Width="100" />
            <Button x:Name="BtnStop" Content="停止" Style="{StaticResource Ghost}" Click="OnStop" Width="100" Margin="10,0,0,0" />
            <Button x:Name="BtnOpen" Content="打开控制台" Style="{StaticResource Ghost}" Click="OnOpen" Width="130" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
